import os
from pathlib import Path

configfile: "config/config.yaml"


def expanduser(p):
    return os.path.expanduser(p)


WORK_DIR = expanduser(config["work_dir"])
REF_DIR = f"{WORK_DIR}/references"
RESULTS = f"{WORK_DIR}/results"
LOGDIR = f"{WORK_DIR}/logs"
BENCHDIR = f"{WORK_DIR}/benchmarks"
TMPDIR = f"{WORK_DIR}/tmp"

ENV_ALIGN = expanduser(config["envs"]["align"])
ENV_ICHORCNA = expanduser(config["envs"]["ichorcna"])
ENV_REPORT = expanduser(config["envs"]["report"])
ENV_KRAKENUNIQ = expanduser(config["envs"]["krakenuniq"])

INPUT_DIR = config["input_dir"]


def discover_samples():
    """Nanopore: input/<sample>/*.fastq(.gz) Unterordner (wird konkateniert).
    Illumina:  input/<sample>_R1_001.fastq.gz + _R2_001.fastq.gz, flach
               (gleiche Erkennung wie im ursprünglichen krakenuniq-report/
               run_pipeline.sh -- nur R1-Dateien mit passender R2 zählen)."""
    base = Path(INPUT_DIR)
    platform = {}
    illumina_pairs = {}
    if not base.is_dir():
        return platform, illumina_pairs

    for p in sorted(base.iterdir()):
        if p.is_dir():
            platform[p.name] = "nanopore"

    for r1 in sorted(base.glob("*_R1_001.fastq.gz")):
        r2 = Path(str(r1).replace("_R1_001.fastq.gz", "_R2_001.fastq.gz"))
        if r2.exists():
            name = r1.name[: -len("_R1_001.fastq.gz")]
            platform[name] = "illumina"
            illumina_pairs[name] = (str(r1), str(r2))

    return platform, illumina_pairs


def nanopore_sample_fastqs(sample):
    base = Path(INPUT_DIR) / sample
    files = sorted(set(base.rglob("*.fastq.gz")) | set(base.rglob("*.fastq")),
                    key=lambda p: str(p))
    if not files:
        raise ValueError(f"Keine FASTQ-Dateien unter {base} gefunden")
    return [str(f) for f in files]


SAMPLE_PLATFORM, ILLUMINA_PAIRS = discover_samples()
SAMPLES = sorted(SAMPLE_PLATFORM)
NANOPORE_SAMPLES = sorted(s for s, p in SAMPLE_PLATFORM.items() if p == "nanopore")
ILLUMINA_SAMPLES = sorted(s for s, p in SAMPLE_PLATFORM.items() if p == "illumina")

wildcard_constraints:
    sample="|".join(SAMPLES) if SAMPLES else "NOSAMPLES",


